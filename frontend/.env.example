# HerCare Frontend Environment Configuration
# Copy this file to .env.local and fill in actual values

# API Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT=30000  # milliseconds

# Application Settings
VITE_APP_NAME=HerCare
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_USER_ACCOUNTS=false
VITE_ENABLE_DARK_MODE=true

# External Services (future)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Development
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# Image Upload Settings
VITE_MAX_IMAGE_SIZE=10485760  # 10MB in bytes
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/bmp
