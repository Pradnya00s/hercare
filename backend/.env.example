# HerCare Backend Environment Configuration
# Copy this file to .env and fill in actual values

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/hercare

# CORS Settings (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Settings
CNN_MODEL_PATH=pcos_screener/model/model.h5
ENSEMBLE_MODEL_PATH=pcos_screener/model/pcos_ensemble_model.pkl
SCALER_MODEL_PATH=pcos_screener/model/scaler.pkl

# Image Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
TEMP_FILE_DIRECTORY=/tmp  # /tmp for Linux/Mac, %TEMP% for Windows

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/hercare.log

# Email Settings (for future notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Redis Cache (optional, for production)
REDIS_URL=redis://localhost:6379/0

# Sentry Error Tracking (optional)
SENTRY_DSN=

# API Settings
API_TIMEOUT=30  # seconds
MAX_BATCH_SIZE=10  # for batch predictions

# TensorFlow/ML Settings
TF_FORCE_GPU_ALLOW_GROWTH=true
NUMBA_DISABLE_JIT=0
